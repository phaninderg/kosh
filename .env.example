# Everything is optional. Nothing personal is configured here: your name, passwords, mailbox settings and statements are all
# entered in the browser and kept encrypted in your own profile.

# UI_PORT=8765                  # the port the server listens on
# KOSH_PUBLIC_PORT=8765         # the port your browser uses, if a container publishes it elsewhere
# KOSH_ALLOWED_HOSTS=kosh.example.com      # the domain(s) a hosted server answers to (see docs/HOSTING.md)
# KOSH_TRUST_PROXY=1            # set when a reverse proxy (Caddy, Tailscale serve) in front is the only way in
# KOSH_IDLE_LOCK_HOURS=8        # hours without use before a profile's data locks and needs its password again
