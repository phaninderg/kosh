# Everything is optional. Secrets (mailbox app passwords, your name, date of birth, PAN, mobile, PDF passwords) are set in the
# UI (Mailboxes and Identity pages) and kept in the OS keyring, not here.

# FINANCE_DB_PATH=data/finance.db
# UI_PORT=8765
# LEDGER_HASH_KEY=            # otherwise a random key is kept in data/.hash_key (mode 0600)

# Fallback for a default PDF password (any statement type) if you do not want to use the Identity page.
CAS_PASSWORD=

# Environment fallbacks for the secrets, if you prefer them to the keyring:
# KOSH_IMAP_<MAILBOX_NAME>=app-password   KOSH_ID_NAME=...   KOSH_ID_DOB=1990-05-17   KOSH_ID_PAN=...   KOSH_ID_MOBILE=...
# KOSH_ID_PASSWORD=...   KOSH_ID_CARD4=1234,5678
